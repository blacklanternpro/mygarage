# MyGarage — Stage 1 environment. Copy to .env.local if you need to change anything.
# No secrets are required for Stage 1; every adapter runs as a deterministic mock.

# Embedded Postgres (PGlite) data directory. Delete it to start from scratch.
PGLITE_DATA_DIR=.data/pglite

# Tenant shown in the demo (seeded workshop slug).
DEMO_WORKSHOP_SLUG=south-west-mechanical

# Optional fixed clock for repeatable demos/tests (ISO 8601). Leave empty for real time.
DEMO_NOW=

# Adapter selection: mock | live. Live adapters arrive in Stage 2/3 and need credentials.
ADAPTER_INGESTION=mock   # Stage 2: OCR (Textract/Azure Read) + Gemini Flash-Lite
ADAPTER_NEVDIS=mock      # Stage 2: BlueFlag / InfoAgent
ADAPTER_SMS=mock         # Stage 2: Texto / DataFlows (ACMA-registered Sender ID)
ADAPTER_WALLET=mock      # Stage 2: Apple PassKit + Google Wallet (in-house signing)
ADAPTER_STT=mock         # Stage 3: Deepgram Nova-3 (or OpenAI gpt-transcribe). Never whisper-1.
ADAPTER_MEDIA=mock       # Stage 2: Cloudflare R2
ADAPTER_PAYMENT=mock     # Stage 3: Stripe Australia (PayTo, card, wallets, BNPL)

# Stage 2+ placeholders (leave blank in Stage 1, never commit real values)
# DATABASE_URL=postgres://...ap-southeast-2.rds.amazonaws.com/mygarage
# GEMINI_API_KEY=
# TEXTO_API_KEY=
# BLUEFLAG_API_KEY=
# DEEPGRAM_API_KEY=
# R2_ACCOUNT_ID= R2_ACCESS_KEY_ID= R2_SECRET_ACCESS_KEY= R2_BUCKET=
# STRIPE_SECRET_KEY=
# APPLE_PASS_TYPE_ID= APPLE_TEAM_ID= APPLE_PASS_CERT_P12_BASE64=
# GOOGLE_WALLET_ISSUER_ID= GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=
