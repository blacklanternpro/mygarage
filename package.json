    "@types/node": "^22.20.7",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.65.1",
    "tailwindcss": "4.3.3",
